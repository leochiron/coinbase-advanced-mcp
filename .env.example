COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_TRADING_ENABLED=false
DEFAULT_QUOTE_CURRENCY=EUR
AUDIT_DATABASE_PATH=./data/audit.sqlite
# Operator-curated validated sources the assistant consults before analysis/orders.
KNOWLEDGE_SOURCES_PATH=./knowledge/sources.json
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3333
LOG_LEVEL=info

# Paper trading (simulated, audited, never touches Coinbase). Off by default.
PAPER_TRADING_ENABLED=false
PAPER_STARTING_CASH=10000
PAPER_FEE_BPS=60
PAPER_HALF_SPREAD_BPS=2
PAPER_SLIPPAGE_BPS=3
# 1 = full fills. A lower value enables deterministic partial-fill stress tests.
PAPER_PARTIAL_FILL_RATIO=1

# Optional risk guard for live orders. Off by default. 0 = unlimited.
RISK_LIMITS_ENABLED=false
MAX_DAILY_NOTIONAL=0

# V2 research automation. OFF and OBSERVE never submit even paper orders.
# PAPER can route validated research artifacts only to the local PaperBroker.
RESEARCH_AUTOMATION_MODE=OFF
RESEARCH_DECISION_PATH=./reports/research_decision.v1.json
RESEARCH_EMERGENCY_STOP_PATH=./data/research-automation/STOP
RESEARCH_DECISION_MAX_AGE_MINUTES=90
RESEARCH_SCHEDULER_INTERVAL_SECONDS=30
# When true, the scheduler refreshes public data/backtests before consuming the artifact.
RESEARCH_RUN_PIPELINE=false
RESEARCH_PYTHON_COMMAND=python
RESEARCH_PIPELINE_TIMEOUT_SECONDS=900
RESEARCH_MAX_DAILY_LOSS_EUR=50
RESEARCH_MAX_ORDERS_PER_DAY=20
RESEARCH_MAX_OPEN_ORDERS=6
RESEARCH_BLOCK_EXTREME_VOLATILITY=true

# Python research subsystem. These routes use public, unauthenticated GET APIs
# and deliberately accept no Coinbase key, private key, or live-trading switch.
CRYPTO_RESEARCH_PROVIDER=binance
CRYPTO_RESEARCH_HTTP_TIMEOUT_SECONDS=20
